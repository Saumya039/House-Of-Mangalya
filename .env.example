# Local development settings. Copy to .env. NEVER commit .env.
# For production see .env.production.example and deploy/DEPLOY.md.

HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Leave DATABASE_URL empty to use the built-in local Postgres (PGlite, stored in data/pgdata).
# Set it to use a real Postgres (e.g. a Neon "preview" branch) instead.
DATABASE_URL=

# Payments: mock = local fake gateway (blocked in production) | razorpay = real gateway.
# Defaults to razorpay when keys are present, otherwise mock. Use rzp_test_ keys locally.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin portal (http://localhost:3001). Set the password with:  npm run admin:password
# The portal stays disabled until ADMIN_PASSWORD_HASH is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Optional locally, REQUIRED in production (generate with: npm run admin:password -- --totp)
ADMIN_TOTP_SECRET=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
ADMIN_ORIGIN=http://localhost:3001
# Optional comma-separated allow-list of client IPs
ADMIN_ALLOWED_IPS=

# Starting stock for a product the first time the store runs (adjust later in Admin → Inventory)
DEFAULT_STOCK=200
