# Copy to .env and fill in. NEVER commit .env.

# development | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Exact origin customers use (scheme + host + port). Must be https:// in production.
PUBLIC_ORIGIN=http://localhost:3000
# Set to true only when running behind a reverse proxy you control (nginx, Cloudflare, Render…)
TRUST_PROXY=false

# mock = local fake gateway (blocked in production) | razorpay = real gateway
# Defaults to razorpay when keys are present, otherwise mock.
PAYMENT_PROVIDER=mock

# Razorpay Dashboard → Account & Settings → API Keys. Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks. URL: https://<your-domain>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, payment.authorized, order.paid
RAZORPAY_WEBHOOK_SECRET=

DB_PATH=data/orders.db
# Starting stock for a product the first time the store runs (adjust later in Admin → Inventory)
DEFAULT_STOCK=200

# ── Admin portal ────────────────────────────────
# Set the password with:  npm run admin:password   (stores only an scrypt hash here)
# The portal stays disabled until ADMIN_PASSWORD_HASH is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Keep 127.0.0.1 so the admin is reachable only from this machine. On a server, reach it
# through an SSH tunnel:  ssh -L 3001:127.0.0.1:3001 you@server  then open http://localhost:3001
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
ADMIN_ORIGIN=http://localhost:3001
# Optional comma-separated allow-list of client IPs
ADMIN_ALLOWED_IPS=
