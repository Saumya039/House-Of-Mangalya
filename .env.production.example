# Production settings. On Vercel set these in Settings → Environment Variables (Production).
# On your own server copy to .env (chmod 600). NEVER commit real values.

# Postgres connection string (Neon pooled URL recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Real gateway (live keys). The server refuses to start in production without these.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Exact public address of the site (https)
PUBLIC_ORIGIN=https://your-site.example

# Admin sign-in. Generate with:  npm run admin:password -- --generate --totp --print-env
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

DEFAULT_STOCK=200

# Self-hosting only (not needed on Vercel):
# NODE_ENV=production
# TRUST_PROXY=true
# HOST=127.0.0.1
# PORT=3000
# ADMIN_HOST=127.0.0.1
# ADMIN_PORT=3001
# ADMIN_ORIGIN=http://localhost:3001
