# Copy to /opt/mangalya/.env on the server and fill in. chmod 600. NEVER commit.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://houseofmangalya.com
TRUST_PROXY=true

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ADMIN_USERNAME=admin
# generate with: npm run admin:password
ADMIN_PASSWORD_HASH=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3001
ADMIN_ORIGIN=http://localhost:3001

DB_PATH=data/orders.db
DEFAULT_STOCK=200
